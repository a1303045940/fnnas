// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Device Tree for BenDian One (RK3568) - 2026.9.30  fnOS最新V1.2.0701 版本6.18内核 / iStoreOS 24.10.8版本6.6.144内核
 * 完整适配 Rockchip MPP 硬件编解码加速与 RKNPU 驱动栈 在fnOS最新V1.2.0701 版本  内核6.18.18.c1145-trim  上 GPU解码 相册NPU解码 4K解码都支持
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/soc/rockchip,vop2.h>
#include <dt-bindings/thermal/thermal.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/clock/rk3568-cru.h>
#include <rockchip/rk3568.dtsi>
#include "rk3568-vngpu.dtsi"
#include "rk3568-ramoops.dtsi"

/ {
    model = "BenDian One";
    compatible = "bendian,bd-one", "rockchip,rk3568";

    aliases {
        ethernet0 = &gmac1;
        ethernet1 = &gmac0;
        mmc0 = &sdhci;
        serial2 = &uart2;
    };

    chosen {
        stdout-path = "serial2:1500000n8";
    };

/* 默认 512MB CMA：供视频编解码、显示等 DMA 设备按需共享 */
    reserved-memory {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;

        linux,cma {
            compatible = "shared-dma-pool";
            reusable;
            size = <0x0 0x20000000>; /* 512MB 动态复用池 */
            linux,cma-default;
        };
    };

    /* 状态指示灯 */
    gpio-leds {
        compatible = "gpio-leds";
        pinctrl-names = "default";
        pinctrl-0 = <&power_led_pin &status_led_pin>;

        led_power: led-0 {
            label = "red:power";
            gpios = <&gpio4 RK_PB3 GPIO_ACTIVE_LOW>;
            default-state = "on";
        };

        led-1 {
            label = "green:status";
            gpios = <&gpio4 RK_PB1 GPIO_ACTIVE_LOW>;
            linux,default-trigger = "heartbeat";
        };
    };

    /* 温控风扇 */
    fan: gpio-fan {
        compatible = "gpio-fan";
        pinctrl-names = "default";
        pinctrl-0 = <&fan_pins>;
        gpios = <&gpio4 RK_PA7 GPIO_ACTIVE_HIGH>;
        gpio-fan,speed-map = <0 0>, <7500 1>;
        #cooling-cells = <2>;
        cooling-min-level = <0>;
        cooling-max-level = <1>;
        status = "okay";
    };

    hdmi_con: hdmi-con {
        compatible = "hdmi-connector";
        type = "a";
        status = "okay";

        port {
            hdmi_con_in: endpoint {
                remote-endpoint = <&hdmi_out_con>;
            };
        };
    };

    hdmi-sound {
        compatible = "simple-audio-card";
        simple-audio-card,name = "HDMI";
        simple-audio-card,format = "i2s";
        simple-audio-card,mclk-fs = <256>;
        status = "okay";

        simple-audio-card,codec {
            sound-dai = <&hdmi>;
        };

        simple-audio-card,cpu {
            sound-dai = <&i2s0_8ch>;
        };
    };

    adc-keys {
        compatible = "adc-keys";
        io-channels = <&saradc 0>;
        io-channel-names = "buttons";
        keyup-threshold-microvolt = <1800000>;
        poll-interval = <100>;

        button-recovery {
            label = "Recovery";
            linux,code = <KEY_VENDOR>;
            press-threshold-microvolt = <17500>;
        };
    };

    /* 电源架构总线 */
    vcc12v_dcin: vcc12v-dcin {
        compatible = "regulator-fixed";
        regulator-name = "vcc12v_dcin";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <12000000>;
        regulator-max-microvolt = <12000000>;
    };

    vcc3v3_sys: vcc3v3-sys {
        compatible = "regulator-fixed";
        regulator-name = "vcc3v3_sys";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        vin-supply = <&vcc12v_dcin>;
    };

    vcc5v0_sys: vcc5v0-sys {
        compatible = "regulator-fixed";
        regulator-name = "vcc5v0_sys";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <5000000>;
        regulator-max-microvolt = <5000000>;
        vin-supply = <&vcc12v_dcin>;
    };

    vcc5v0_usb: vcc5v0-usb {
        compatible = "regulator-fixed";
        regulator-name = "vcc5v0_usb";
        enable-active-high;
        gpio = <&gpio0 RK_PC1 GPIO_ACTIVE_HIGH>;
        pinctrl-names = "default";
        pinctrl-0 = <&usb_pwr_en>;
        regulator-boot-on;
        regulator-always-on;
        regulator-min-microvolt = <5000000>;
        regulator-max-microvolt = <5000000>;
        vin-supply = <&vcc5v0_sys>;
        startup-delay-us = <1000000>;

        regulator-state-mem {
            regulator-off-in-suspend;
        };
    };

    vcc_3v3: vcc-3v3 {
        compatible = "regulator-fixed";
        regulator-name = "vcc_3v3";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        vin-supply = <&vcc3v3_sys>;
    };

    vcc_1v8: vcc-1v8 {
        compatible = "regulator-fixed";
        regulator-name = "vcc_1v8";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        vin-supply = <&vcc3v3_sys>;
    };

    vcca_1v8: vcca-1v8 {
        compatible = "regulator-fixed";
        regulator-name = "vcca_1v8";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
        vin-supply = <&vcc3v3_sys>;
    };

    vdda_0v9: vdda-0v9 {
        compatible = "regulator-fixed";
        regulator-name = "vdda_0v9";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <900000>;
        regulator-max-microvolt = <900000>;
        vin-supply = <&vcc3v3_sys>;
    };

    vcc3v3_pi6c_03: vcc3v3-pi6c-03 {
        compatible = "regulator-fixed";
        regulator-name = "vcc3v3_pi6c_03";
        enable-active-high;
        gpio = <&gpio0 RK_PC0 GPIO_ACTIVE_HIGH>;
        pinctrl-names = "default";
        pinctrl-0 = <&ssd_pwr_en>;
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        vin-supply = <&vcc12v_dcin>;
        startup-delay-us = <500000>;
    };

    vcc3v3_pcie: vcc3v3-pcie {
        compatible = "regulator-fixed";
        regulator-name = "vcc3v3_pcie";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        vin-supply = <&vcc3v3_pi6c_03>;
    };

    vdd_gpu: vdd-gpu {
        compatible = "pwm-regulator";
        pwms = <&pwm4 0 5000 1>;
        pwm-supply = <&vcc3v3_sys>;
        regulator-name = "vdd_gpu";
        regulator-always-on;
        regulator-boot-on;
        regulator-init-microvolt = <900000>;
        regulator-min-microvolt = <500000>;
        regulator-max-microvolt = <1350000>;
        regulator-ramp-delay = <6001>;
        regulator-settling-time-up-us = <250>;
        pwm-dutycycle-range = <0 100>;
    };

    vdd_logic: vdd-logic {
        compatible = "pwm-regulator";
        pwms = <&pwm5 0 5000 1>;
        pwm-supply = <&vcc3v3_sys>;
        regulator-name = "vdd_logic";
        regulator-always-on;
        regulator-boot-on;
        regulator-init-microvolt = <900000>;
        regulator-min-microvolt = <500000>;
        regulator-max-microvolt = <1350000>;
        regulator-ramp-delay = <6001>;
        regulator-settling-time-up-us = <250>;
        pwm-dutycycle-range = <0 100>;
    };
};

&pwm4 { status = "okay"; };
&pwm5 { status = "okay"; };

&uart3 { status = "disabled"; };
&uart5 { status = "disabled"; };
&i2c5 {
    /delete-property/ pinctrl-names;
    /delete-property/ pinctrl-0;
    status = "disabled";
};
&uart2 { status = "okay"; };

/* CPU 电源管理：FAN53555 / TCS4525 */
&i2c0 {
    status = "okay";

    vdd_cpu: regulator@1c {
        compatible = "tcs,tcs4525", "silergy,syr827", "fcs,fan53555";
        reg = <0x1c>;
        fcs,suspend-voltage-selector = <1>;
        regulator-name = "vdd_cpu";
        regulator-always-on;
        regulator-boot-on;
        regulator-init-microvolt = <900000>;
        regulator-min-microvolt = <712500>;
        regulator-max-microvolt = <1390000>;
        regulator-ramp-delay = <2300>;
        vin-supply = <&vcc5v0_sys>;

        regulator-state-mem {
            regulator-off-in-suspend;
        };
    };
};

&cpu0 { cpu-supply = <&vdd_cpu>; };
&cpu1 { cpu-supply = <&vdd_cpu>; };
&cpu2 { cpu-supply = <&vdd_cpu>; };
&cpu3 { cpu-supply = <&vdd_cpu>; };

/* Mali GPU：绑定供电与调频 */
&gpu {
    mali-supply = <&vdd_gpu>;
    operating-points-v2 = <&gpu_opp_table>;
    power-off-delay-ms = <20>;
    status = "okay";
};

&combphy0 { status = "okay"; };
&combphy1 { status = "okay"; };
&combphy2 { status = "okay"; };

&sata0 {
    status = "okay";
    ahci-supply = <&vcc3v3_sys>;
    phy-supply = <&vcc3v3_sys>;
    target-supply = <&vcc3v3_sys>;
    phys = <&combphy0 PHY_TYPE_SATA>;
    phy-names = "sata-phy";
};

&sata1 {
    status = "okay";
    ahci-supply = <&vcc3v3_sys>;
    phy-supply = <&vcc3v3_sys>;
    target-supply = <&vcc3v3_sys>;
    phys = <&combphy1 PHY_TYPE_SATA>;
    phy-names = "sata-phy";
};

&sdhci {
    bus-width = <8>;
    max-frequency = <200000000>;
    non-removable;
    mmc-hs200-1_8v;
    vmmc-supply = <&vcc_3v3>;
    vqmmc-supply = <&vcc_1v8>;
    pinctrl-names = "default";
    pinctrl-0 = <&emmc_bus8 &emmc_clk &emmc_cmd>;
    status = "okay";
};

/* 单 USB 2.0 拓扑 */
&usb2phy0 { 
    status = "okay"; 
};

&usb2phy0_otg {
    phy-supply = <&vcc5v0_usb>;
    status = "okay";
};

&usb2phy0_host {
    status = "disabled";
};

&usb_host0_xhci {
    dr_mode = "host";
    phys = <&usb2phy0_otg>;
    phy-names = "usb2-phy";
    extcon = <&usb2phy0>;
    maximum-speed = "high-speed";
    snps,dis_u2_susphy_quirk;
    status = "okay";
};

&usb_host0_ehci { status = "disabled"; };
&usb_host0_ohci { status = "disabled"; };
&usb2phy1 { status = "disabled"; };

/* PCIe 2.0 x1 */
&pcie2x1 {
    reset-gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_HIGH>;
    vpcie3v3-supply = <&vcc3v3_sys>;
    pinctrl-names = "default";
    pinctrl-0 = <&pcie20_reset_pin>;
    status = "okay";
};

&pcie30phy {
    status = "okay";
};

&pcie3x2 {
    reset-gpios = <&gpio0 RK_PC6 GPIO_ACTIVE_HIGH>;
    vpcie3v3-supply = <&vcc3v3_pcie>;
    pinctrl-names = "default";
    pinctrl-0 = <&pcie30_reset_pin>;
    rockchip,perst-inactive-ms = <500>;
    status = "okay";
};

/* =================== 网络架构：RTL8367S DSA + RTL8211F (原机对齐版) =================== */

/* 1. GMAC0：连接 RTL8367S 交换机 CPU Port 7 (完全对齐原机时序与延时) */
&gmac0 {
    assigned-clocks = <&cru SCLK_GMAC0_RX_TX>, <&cru SCLK_GMAC0>;
    assigned-clock-parents = <&cru SCLK_GMAC0_RGMII_SPEED>, <&cru CLK_MAC0_2TOP>;
    assigned-clock-rates = <0>, <125000000>;
    clock_in_out = "output";
    phy-mode = "rgmii";
    /delete-property/ phy-handle;
    pinctrl-names = "default";
    pinctrl-0 = <&gmac0_miim &gmac0_tx_bus2 &gmac0_rx_bus2
                 &gmac0_rgmii_clk &gmac0_rgmii_bus>;
    tx_delay = <0x4f>;
    rx_delay = <0x0f>;
    status = "okay";

    fixed-link {
        speed = <1000>;
        full-duplex;
    };
};

/* 2. MDIO0：管理 RTL8367S 交换芯片及其 4 个千兆内部 PHY (DSA 结构) */
&mdio0 {
    compatible = "snps,dwmac-mdio";
    #address-cells = <1>;
    #size-cells = <0>;

    rtl8367s: switch@1d {
        compatible = "realtek,rtl8365mb";
        reg = <0x1d>;
        reset-gpios = <&gpio0 RK_PA3 GPIO_ACTIVE_LOW>;
        reset-assert-us = <50000>;
        reset-deassert-us = <200000>;
        pinctrl-names = "default";
        pinctrl-0 = <&rtl8367_reset_pin &rtl8367_int_pin>;

        /* 原机硬件中断控制器：解决网口轮询导致的响应卡顿与吞吐抖动 */
        rtl8367_intc: interrupt-controller {
            interrupt-parent = <&gpio0>;
            interrupts = <RK_PA4 IRQ_TYPE_LEVEL_LOW>;
            interrupt-controller;
            #address-cells = <0>;
            #interrupt-cells = <1>;
        };

        mdio {
            compatible = "realtek,smi-mdio";
            #address-cells = <1>;
            #size-cells = <0>;

            phy0: ethernet-phy@0 {
                reg = <0>;
                interrupt-parent = <&rtl8367_intc>;
                interrupts = <0>;
            };

            phy1: ethernet-phy@1 {
                reg = <1>;
                interrupt-parent = <&rtl8367_intc>;
                interrupts = <1>;
            };

            phy2: ethernet-phy@2 {
                reg = <2>;
                interrupt-parent = <&rtl8367_intc>;
                interrupts = <2>;
            };

            phy3: ethernet-phy@3 {
                reg = <3>;
                interrupt-parent = <&rtl8367_intc>;
                interrupts = <3>;
            };
        };

        ports {
            #address-cells = <1>;
            #size-cells = <0>;

            port@0 {
                reg = <0>;
                label = "lan4";
                phy-mode = "internal";
                phy-handle = <&phy0>;
            };

            port@1 {
                reg = <1>;
                label = "lan3";
                phy-mode = "internal";
                phy-handle = <&phy1>;
            };

            port@2 {
                reg = <2>;
                label = "lan2";
                phy-mode = "internal";
                phy-handle = <&phy2>;
            };

            port@3 {
                reg = <3>;
                label = "lan1";
                phy-mode = "internal";
                phy-handle = <&phy3>;
            };

            port@7 {
                reg = <7>;
                label = "cpu";
                ethernet = <&gmac0>;
                phy-mode = "rgmii";

                fixed-link {
                    speed = <1000>;
                    full-duplex;
                };
            };
        };
    };
};

/* 3. GMAC1：原机独立第五网口 (RTL8211F) */
&gmac1 {
    assigned-clocks = <&cru SCLK_GMAC1_RX_TX>, <&cru SCLK_GMAC1>;
    assigned-clock-parents = <&cru SCLK_GMAC1_RGMII_SPEED>, <&cru CLK_MAC1_2TOP>;
    assigned-clock-rates = <0>, <125000000>;
    clock_in_out = "output";
    phy-mode = "rgmii";
    phy-handle = <&rgmii_phy1>;

    pinctrl-names = "default";
    pinctrl-0 = <&gmac1m0_miim &gmac1m0_tx_bus2 &gmac1m0_rx_bus2
                 &gmac1m0_rgmii_clk &gmac1m0_rgmii_bus>;

    tx_delay = <0x4f>;
    rx_delay = <0x10>;
    status = "okay";
};

&mdio1 {
    rgmii_phy1: ethernet-phy@0 {
        compatible = "ethernet-phy-id001c.c916", "ethernet-phy-ieee802.3-c22";
        reg = <0>;
        reset-gpios = <&gpio1 RK_PB1 GPIO_ACTIVE_LOW>;
        reset-assert-us = <20000>;
        reset-deassert-us = <100000>;
        realtek,led-data = <0x17b>;
    };
};

/* CPU 温控 */
&cpu_thermal {
    polling-delay = <1000>;
    polling-delay-passive = <250>;

    /delete-node/ trips;
    /delete-node/ cooling-maps;

    trips {
        cpu_fan_on: cpu-fan-on {
            temperature = <75000>;
            hysteresis = <10000>;
            type = "active";
        };

        cpu_alert0: cpu-alert0 {
            temperature = <75000>;
            hysteresis = <5000>;
            type = "passive";
        };

        cpu_alert1: cpu-alert1 {
            temperature = <85000>;
            hysteresis = <2000>;
            type = "passive";
        };

        cpu_crit: cpu-crit {
            temperature = <95000>;
            hysteresis = <2000>;
            type = "critical";
        };
    };

    cooling-maps {
        map_fan {
            trip = <&cpu_fan_on>;
            cooling-device = <&fan 1 1>;
        };

        map_cpu_mild {
            trip = <&cpu_alert0>;
            cooling-device = <&cpu0 THERMAL_NO_LIMIT 2>;
        };

        map_cpu_heavy {
            trip = <&cpu_alert1>;
            cooling-device = <&cpu0 2 THERMAL_NO_LIMIT>;
        };
    };
};

/* GPU 温控 */
&gpu_thermal {
    polling-delay = <1000>;
    polling-delay-passive = <250>;

    /delete-node/ trips;
    /delete-node/ cooling-maps;

    trips {
        gpu_fan_on: gpu-fan-on {
            temperature = <75000>;
            hysteresis = <10000>;
            type = "active";
        };

        gpu_alert: gpu-alert {
            temperature = <75000>;
            hysteresis = <2000>;
            type = "passive";
        };

        gpu_crit: gpu-crit {
            temperature = <95000>;
            hysteresis = <2000>;
            type = "critical";
        };
    };

    cooling-maps {
        map_fan {
            trip = <&gpu_fan_on>;
            cooling-device = <&fan 1 1>;
        };

        map_gpu {
            trip = <&gpu_alert>;
            cooling-device = <&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
        };
    };
};

/* =================== 显示与多媒体系统 =================== */

/* 1. HDMI 控制器 */
&hdmi {
    status = "okay";
    #sound-dai-cells = <0>;

    avdd-0v9-supply = <&vdda_0v9>;
    avdd-1v8-supply = <&vcca_1v8>;

    pinctrl-names = "default";
    pinctrl-0 = <&hdmitx_scl>,
                <&hdmitx_sda>,
                <&hdmitxm0_cec>;
};

/* 2. HDMI 输出端口连接到物理接插件插座 */
&hdmi_out {
    hdmi_out_con: endpoint {
        remote-endpoint = <&hdmi_con_in>;
    };
};

/* 3. HDMI 输入端口连接到 VOP2 的 VP0 */
&hdmi_in {
    hdmi_in_vp0: endpoint {
        remote-endpoint = <&vp0_out_hdmi>;
    };
};

/* 4. VOP2 的 VP0 端点：明确标识为 HDMI0 输出端口通道 */
&vp0 {
    vp0_out_hdmi: endpoint@ROCKCHIP_VOP2_EP_HDMI0 {
        reg = <ROCKCHIP_VOP2_EP_HDMI0>;
        remote-endpoint = <&hdmi_in_vp0>;
    };
};

/* 5. VOP2 显示核心：精准绑定 HPLL / VPLL 专有时钟源 */
&vop {
    assigned-clocks = <&cru DCLK_VOP0>, <&cru DCLK_VOP1>;
    assigned-clock-parents = <&pmucru PLL_HPLL>, <&cru PLL_VPLL>;
    status = "okay";
};

&vop_mmu {
    status = "okay";
};

&i2s0_8ch {
    status = "okay";
};

&saradc {
    vref-supply = <&vcca_1v8>;
    status = "okay";
};

&tsadc {
    rockchip,hw-tshut-mode = <1>;
    rockchip,hw-tshut-polarity = <0>;
    status = "okay";
};

&pmu_io_domains {
    pmuio1-supply = <&vcc_3v3>;
    pmuio2-supply = <&vcc_3v3>;
    vccio1-supply = <&vcc_3v3>;
    vccio2-supply = <&vcc_1v8>;
    vccio3-supply = <&vcc_3v3>;
    vccio4-supply = <&vcc_1v8>;
    vccio5-supply = <&vcc_3v3>;
    vccio6-supply = <&vcc_1v8>;
    vccio7-supply = <&vcc_3v3>;
    status = "okay";
};

&pinctrl {
    fan {
        fan_pins: fan-pins {
            rockchip,pins = <4 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
        };
    };

    gpio-leds {
        power_led_pin: power-led-pin {
            rockchip,pins = <4 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
        };

        status_led_pin: status-led-pin {
            rockchip,pins = <4 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
        };
    };

    pcie {
        ssd_pwr_en: ssd-pwr-en {
            rockchip,pins = <0 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>;
        };

        pcie30_reset_pin: pcie30-reset-pin {
            rockchip,pins = <0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>;
        };

        pcie20_reset_pin: pcie20-reset-pin {
            rockchip,pins = <3 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
        };
    };

    usb {
        usb_pwr_en: usb-pwr-en {
            rockchip,pins = <0 RK_PC1 RK_FUNC_GPIO &pcfg_pull_down>;
        };
    };

    gmac-reset {
        rtl8367_reset_pin: rtl8367-reset-pin {
            rockchip,pins = <0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>;
        };

        /* 补充：中断引脚默认上拉，防止开机悬空毛刺 */
        rtl8367_int_pin: rtl8367-int-pin {
            rockchip,pins = <0 RK_PA4 RK_FUNC_GPIO &pcfg_pull_up>;
        };
    };
}; 

/*彻底禁用无用的 SDIO Wi-Fi 节点（清理系统报错）*/

&sdmmc2 {
    status = "disabled";
};

/* =================== 硬件加速与外设使能 =================== */

/* NPU 神经网络加速器 */
&bus_npu {
    bus-supply = <&vdd_logic>;
    status = "okay";
};

/* 硬件视频编码 */
&rkvenc {
    venc-supply = <&vdd_logic>;
    operating-points-v2 = <&rkvenc_opp_table>;
    status = "okay";
};

/* 硬件视频解码 */
&rkvdec {
    vdec-supply = <&vdd_logic>;
    operating-points-v2 = <&rkvdec_opp_table>;
    status = "okay";

    /* 优化项：补全 7 路微内核与 CABAC 复位信号，防止 4K 拖动死锁 */
    resets = <&cru SRST_A_RKVDEC>, <&cru SRST_H_RKVDEC>,
             <&cru SRST_RKVDEC_CA>, <&cru SRST_RKVDEC_CORE>,
             <&cru SRST_RKVDEC_HEVC_CA>,
             <&cru SRST_A_VPU_NIU>, <&cru SRST_H_VPU_NIU>;

    reset-names = "video_a", "video_h", "video_cabac",
                  "video_core", "video_hevc_cabac",
                  "shared_niu_a", "shared_niu_h";
};

/* 建议紧跟在 &rkvdec 后显式使能 MMU */
&rkvdec_mmu {
    status = "okay";
};

/* 图像后期处理引擎（针对字幕渲染、视频缩放增强） */
&iep {
    status = "okay";
};

&iep_mmu {
    status = "okay";
};

/* JPEG 硬件硬解（提升飞牛相册海量图片瞬间缩略图生成速度） */
&jpegd {
    status = "okay";
};

&jpegd_mmu {
    status = "okay";
};
/* 3. eFuse/OTP：重映射 4 时钟 + 复位，激活 AVS 自适应调压 */
/* eFuse/OTP 控制器：双系统（fnOS BSP 驱动 + iStoreOS 主线 6.6 驱动）双向全兼容配置 */
&otp {
    clocks = <&cru CLK_OTPC_NS_USR>,
             <&cru CLK_OTPC_NS_USR>,
             <&cru CLK_OTPC_NS_SBPI>,
             <&cru PCLK_OTPC_NS>,
             <&cru PCLK_OTPC_NS>,
             <&cru PCLK_OTPPHY>;

    clock-names = "usr", "otp", "sbpi", "apb", "apb_pclk", "phy";

    resets = <&cru SRST_OTPPHY>;
    reset-names = "otp_phy";

    status = "okay";
};

/* 针对 fnOS 当前 vendor RKNPU 驱动的资源重叠规避；非通用硬件定义 */
&rknpu {
    reg = <0x0 0xfde40000 0x0 0x3000>;
    rknpu-supply = <&vdd_logic>;
    status = "okay";
};

&rknpu_mmu {
    status = "okay";
};

/* 开启硬件真随机数：加速 SSH 连接、TLS/HTTPS 证书握手与加密传输速度 */
&rng {
    status = "okay";
};

/* 开启硬件看门狗：当底层内核严重死锁或供电异常假死时，自动硬件复位重启，避免变砖断联 */
&wdt {
    status = "okay";
};
